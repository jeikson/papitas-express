# ---------------------------------------------------------------------------
# Reglas para hosting Apache / cPanel (Hostinger, GoDaddy, Hostgator, etc.).
# Si subes la web a Netlify o Cloudflare Pages este archivo se ignora solo:
# ahí manda el archivo "_headers". Puedes borrarlo sin problema.
# ---------------------------------------------------------------------------

# Que el teléfono entienda los archivos nuevos (si no, no ofrece instalar la app)
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddDefaultCharset UTF-8
DirectoryIndex index.html

# Comprimir: el HTML, el CSS y el JS bajan hasta 4 veces más rápido
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/manifest+json image/svg+xml
</IfModule>

# Cuánto guarda el teléfono cada archivo
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Sin listados de carpeta
Options -Indexes
