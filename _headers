# Reglas de caché y cabeceras para Netlify y Cloudflare Pages.
# El hosting lee este archivo tal cual; en un hosting Apache usa .htaccess.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# El HTML nunca se guarda: es lo que trae los números de versión nuevos.
/index.html
  Cache-Control: no-cache

# El service worker tampoco: si se guarda, el teléfono no ve las actualizaciones.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# CSS y JS van con ?v=N en el HTML: cada publicación cambia la dirección.
/css/*
  Cache-Control: public, max-age=2592000

/js/*
  Cache-Control: public, max-age=2592000

# Tipografías: el nombre no cambia nunca.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Fotos e iconos: se guardan poco, para que al reemplazar una foto se vea pronto.
/assets/img/*
  Cache-Control: public, max-age=604800

/assets/icons/*
  Cache-Control: public, max-age=604800
